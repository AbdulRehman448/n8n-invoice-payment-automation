    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst today = new Date();\ntoday.setHours(0,0,0,0);\n\nconst results = [];\n\nfor (const item of items) {\n  const status = (item.json.status || '').toLowerCase();\n  if (status === 'paid') continue;\n\n  const dueDateStr = item.json.due_date || '';\n  if (!dueDateStr) continue;\n\n  const dueDate = new Date(dueDateStr);\n  dueDate.setHours(0,0,0,0);\n\n  const diffDays = Math.floor((dueDate - today) / (1000 * 60 * 60 * 24));\n\n  let reminderType = null;\n\n  if (diffDays >= 1 && diffDays <= 5) reminderType = 'upcoming';\n  else if (diffDays === 0) reminderType = 'due_today';\n  else if (diffDays < 0) reminderType = `overdue_${Math.abs(diffDays)}days`;\n\n  if (reminderType) {\n    results.push({\n      json: {\n        client_name: item.json.client_name || '',\n        client_email: item.json.client_email || '',\n        invoice_number: item.json.invoice_number || '',\n        amount: item.json.amount || '',\n        due_date: dueDateStr,\n        status: item.json.status || 'Unpaid',\n        reminder_type: reminderType,\n        days_diff: diffDays\n      }\n    });\n  }\n}\n\nif (results.length === 0) {\n  return [{ json: { skip: true, message: 'No invoices need reminders today' } }];\n}\n\nreturn results;"
      },
