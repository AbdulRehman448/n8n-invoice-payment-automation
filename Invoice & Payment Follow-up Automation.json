    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst results = [];\n\nfor (const invoice of $('Check Skip').all()) {\n  const inv = invoice.json.invoice_number || '';\n  if (!inv || seen.has(inv)) continue;\n  seen.add(inv);\n  \n  results.push({\n    json: {\n      client_name: invoice.json.client_name || '',\n      client_email: invoice.json.client_email || '',\n      invoice_number: inv,\n      amount: invoice.json.amount || '',\n      due_date: invoice.json.due_date || '',\n      reminder_type: invoice.json.reminder_type || '',\n      sent_at: new Date().toLocaleString('en-PK', { timeZone: 'Asia/Karachi' })\n    }\n  });\n}\n\nreturn results;"
      },
